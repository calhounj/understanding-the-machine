#Count the number of characters in a string
.globl _start
.section .data
mytext:
	.ascii "Hello big wonderful world!\0"

.section .text
_start:
	movq $mytext, %rbx
	movq $0, %rdi

mainloop:
	movb (%rbx), %al
	cmpb $0, %al
	je finish

	incb %rbx
	incq %rdi
	jmp mainloop

finish:
	movq $60, %rax
	syscall
